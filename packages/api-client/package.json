{
  "name": "@toko/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Kontrak OpenAPI dan typed client internal Keuangan Toko.",
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check-generated": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler src/index.ts"
  }
}
